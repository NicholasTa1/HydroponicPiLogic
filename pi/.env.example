# Copy this file to .env (same directory) and fill in real values. .env is gitignored.

# Supabase: Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-or-anon-key
# Optional: the app user whose account the readings appear under (defaults to admin)
SUPABASE_USERNAME=admin
# Optional: which growing system this Pi is, as shown in the app. By default each Pi names
# itself HydroPi-<8 hex digits from its serial number>, which is already unique; the name is
# printed when main.py starts. Uncomment only to use a friendly name instead:
# HYDRO_SYSTEM_NAME=Tower A

# Edenic (Bluelab Guardian EC). API key and organization id come from app.edenic.io.
# Find the device id by running: python3 list_edenic_devices.py
# Note: Edenic API keys expire after one year.
EDENIC_API_KEY=your-edenic-api-key
EDENIC_ORGANIZATION_ID=your-organization-id
EDENIC_DEVICE_ID=your-guardian-device-id
