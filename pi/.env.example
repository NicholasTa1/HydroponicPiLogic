# Copy this file to .env (same directory) and fill in real values. .env is gitignored.
# Find these in the Supabase dashboard: Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-or-anon-key
# Optional: the app user whose account the readings appear under (defaults to admin)
SUPABASE_USERNAME=admin
